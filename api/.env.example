# String de conexão MongoDB Atlas
MONGO_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/guiadoa?retryWrites=true&w=majority

# Segredo para assinar os tokens JWT do painel admin
JWT_SECRET=troque_por_uma_string_longa_e_aleatoria

# Porta local (o Render ignora isso e usa a variável PORT dele)
PORT=3001

# Origens extras autorizadas no CORS, separadas por vírgula
# ALLOWED_ORIGINS=https://meudominio.com,https://outro.com
